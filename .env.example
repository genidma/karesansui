# =============================================================================
# karesansui — LLM API Configuration
# =============================================================================
# Supported providers: OpenRouter, NVIDIA NIM (or any OpenAI-compatible API)
# =============================================================================

# --- API Key (required) ---
# OpenRouter: sk-or-...
# NVIDIA:     nvapi-...
LLM_API_KEY=your-api-key-here

# --- API URL (optional) ---
# Default: https://openrouter.ai/api/v1/chat/completions
# NVIDIA:  https://integrate.api.nvidia.com/v1/chat/completions
# LLM_API_URL=https://integrate.api.nvidia.com/v1/chat/completions

# --- Model (optional) ---
# OpenRouter default: tencent/hy3:free
# NVIDIA examples:    nvidia/llama-3.1-nemotron-70b-instruct, mistralai/mixtral-8x22b-instruct-v0.1
LLM_MODEL=tencent/hy3:free

# =============================================================================
# Legacy env vars (still supported for backward compatibility):
#   OPENROUTER_API_KEY  → same as LLM_API_KEY
#   OPENROUTER_MODEL    → same as LLM_MODEL
#   OPENROUTER_URL      → same as LLM_API_URL
# =============================================================================
